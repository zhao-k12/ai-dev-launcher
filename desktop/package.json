{
  "name": "ai-dev-launcher-desktop",
  "private": true,
  "version": "2.4.0",
  "description": "Windows desktop interface for AI Dev Launcher",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "package:win": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "lint": "eslint src electron tests --max-warnings 0",
    "test:e2e": "npm run build && node tests/electron.e2e.mjs"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.aidevlauncher.desktop",
    "productName": "AI Dev Launcher",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/preload/index.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-dist/ai-dev-core.exe",
        "to": "ai-dev-core.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Dev-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Dev Launcher",
      "include": "build/installer.nsh"
    }
  }
}
